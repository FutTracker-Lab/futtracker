# Copiar a .env.local y completar. `.env.local` está gitignoreado.
#
# Los valores salen del dashboard de Supabase, en Project Settings → API.
# Hay tres juegos distintos y no se mezclan:
#
#   local → los que imprime `supabase start`
#   dev   → proyecto futtracker-dev   (scope Preview en Vercel)
#   prod  → proyecto futtracker-prod  (scope Production en Vercel)
#
# Ninguna clave de prod se carga nunca en local ni en dev.

# URL del proyecto: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave publishable (sb_publishable_...).
# Es pública por diseño: viaja en el bundle del browser. No protege nada —
# toda la autorización real la hacen las políticas de RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (sb_secret_...). OPCIONAL: hoy no la usa ningún módulo.
# Saltea RLS por completo. Solo servidor, nunca con prefijo NEXT_PUBLIC_ y
# nunca importada desde un módulo que cruce un límite "use client".
# Se valida en lib/env/server.ts, que está marcado con `server-only`.
SUPABASE_SECRET_KEY=
